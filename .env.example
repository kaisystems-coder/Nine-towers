# Copy to .env.local for local development. Nothing here is required on Vercel:
# the Supabase settings have public defaults in lib/supabase/config.ts.

# Web3Forms access key (free at https://web3forms.com). Powers the newsletter
# sign-up and the contact form.
NEXT_PUBLIC_WEB3FORMS_KEY=

# The live domain, used for canonical URLs, the sitemap and social previews.
NEXT_PUBLIC_SITE_URL=https://ninetowerscollection.com

# Optional overrides for the shared Supabase project (see supabase/README.md).
# Only set these to point this codebase at another project or tenant.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# TENANT_ID=
# ADMIN_EMAIL=
