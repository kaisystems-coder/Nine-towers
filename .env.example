# Copy to .env.local for local development, and add the same names in
# Vercel → Project → Settings → Environment Variables for the live site.

# Web3Forms access key (free at https://web3forms.com). Powers the newsletter
# sign-up and the contact form.
NEXT_PUBLIC_WEB3FORMS_KEY=

# The live domain, used for canonical URLs, the sitemap and social previews.
NEXT_PUBLIC_SITE_URL=https://ninetowerscollection.com

# Admin sign-in at /admin. Use a long password only you know.
ADMIN_PASSWORD=
# Optional: a long random string that signs admin sessions. If left empty the
# password is used, so changing the password signs everyone out.
ADMIN_SESSION_SECRET=

# Set automatically when you connect a Vercel Blob store to the project
# (Vercel → Storage → Create → Blob). Lets the admin save products and photos
# on the live site. Without it, the admin saves to data/products.json locally.
BLOB_READ_WRITE_TOKEN=
